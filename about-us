  <!-- Inbuilt Form Script (No Third-Party Dependencies) -->
  <script>
    function sendMail(event) {
      event.preventDefault(); // Prevent the page from refreshing

      // 1. Get the values from the form
      let name = document.getElementById("name").value;
      let email = document.getElementById("email").value;
      let subject = document.getElementById("subject").value;
      let message = document.getElementById("message").value;

      // 2. Format the body of the email
      let body = "Name: " + name + "\r\n" +
                 "Email: " + email + "\r\n\r\n" +
                 "Message:\r\n" + message;

      // 3. Construct the mailto link
      let mailtoLink = "mailto:swa.eng.87@gmail.com" +
                       "?subject=" + encodeURIComponent(subject) +
                       "&body=" + encodeURIComponent(body);

      // 4. Trigger the user's default email client
      window.location.href = mailtoLink;
      
      return false;
    }
  </script>

